# Backend Express API Environment Variables
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rakshak_db

# Redis Connection
REDIS_URL=redis://localhost:6379

# Inter-service URLs
TRIAGE_SERVICE_URL=http://localhost:8000

# Authentication & Session Security (Phase 26 Hardened)
JWT_SECRET=replace_this_with_a_secure_random_string_in_production
JWT_REFRESH_SECRET=replace_this_with_a_secure_refresh_secret_in_production
CORS_ORIGIN=http://localhost:5173

# Cryptographic Keys (Photo Encryption & Device HMAC)
PHOTO_ENCRYPTION_SECRET=replace_with_32_byte_minimum_master_secret
DEVICE_HMAC_SECRET=replace_with_32_byte_minimum_device_secret

# TLS / HTTPS Configuration
USE_HTTPS=false
SSL_CERT_PATH=certs/cert.pem
SSL_KEY_PATH=certs/key.pem
