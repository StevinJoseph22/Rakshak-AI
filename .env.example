# Rakshak-AI Root Environment Variables

# PostgreSQL + PostGIS Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rakshak_db
POSTGRES_PORT=5432

# Redis Cache & Message Broker
REDIS_PORT=6379

# Service Local Endpoints
BACKEND_PORT=5000
TRIAGE_SERVICE_PORT=8000
DASHBOARD_PORT=5173
