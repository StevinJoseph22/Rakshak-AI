# Triage Service FastAPI Environment Variables
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Database (PostgreSQL + PostGIS for spatial queries)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rakshak_db

# Redis (Queue / PubSub for incident jobs)
REDIS_URL=redis://localhost:6379

# Inter-service URLs
BACKEND_SERVICE_URL=http://localhost:5000

# AI / Optimization Models (Optional / Future expansion)
AI_MODEL_WEIGHTS_PATH=models/triage_v1.onnx
