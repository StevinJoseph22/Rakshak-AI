# Dashboard React + Vite Environment Variables

# Backend API Endpoint
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Real-time WebSocket Server
VITE_WS_URL=ws://localhost:5000

# Geospatial Map Provider Key (Mapbox, Google Maps, or OpenStreetMap)
VITE_MAP_PROVIDER_KEY=placeholder_map_key_here

# Default Map Center (Lat, Lng)
VITE_DEFAULT_MAP_LAT=28.6139
VITE_DEFAULT_MAP_LNG=77.2090
